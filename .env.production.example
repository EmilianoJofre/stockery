# ── Dominio ───────────────────────────────────────────────────
APP_DOMAIN=stockery.cl
LETSENCRYPT_EMAIL=tu@email.com

# ── Rails ─────────────────────────────────────────────────────
RAILS_ENV=production
RAILS_ALLOWED_HOSTS=stockery.cl,www.stockery.cl
FRONTEND_ORIGINS=https://stockery.cl,https://www.stockery.cl

# Generar con: openssl rand -hex 64
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_64_CHARS

# Generar con: cd stockify-api && bundle exec rails secret | head -c 32
# O bien: openssl rand -hex 16
RAILS_MASTER_KEY=CAMBIAR_POR_MASTER_KEY_32_CHARS

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=stockify
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=stockify_production

# Construida a partir de los valores anteriores:
DATABASE_URL=postgresql://stockify:CAMBIAR_POR_PASSWORD_SEGURO@postgres:5432/stockify_production
