# Build del frontend — contexto debe ser la raíz del monorepo
# docker build -f docker/Dockerfile.web.prod -t stockery-web .

# ── Stage 1: build ────────────────────────────────────────────
FROM node:18-alpine AS build

WORKDIR /app

COPY stockify-web/package*.json ./
RUN npm ci --prefer-offline

COPY stockify-web/ .
RUN npm run build

# ── Stage 2: serve con Caddy ──────────────────────────────────
FROM caddy:2-alpine

COPY --from=build /app/dist /srv/public
COPY docker/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

# Verificar que Caddy está aceptando conexiones en puerto 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD nc -zw3 localhost 80 || exit 1
